## The Max of Two Numbers
num1=int(input("enter first number: "))
num2=int(input("enter second number: "))
number_list=[]
number_list.append(num1)
number_list.append(num2)
print(number_list)
larger_number=0
larger_number=max(number_list)
print(f"The max is : {larger_number}")


